# Blender 4.0.2 MTL File: 'Oil Lamp1.blend'
# www.blender.org

newmtl Flame
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.450000
d 1.000000
illum 2
map_Kd C:/Flame_BaseColor.png
map_Ns C:/Flame_Roughness.png
map_refl C:/Flame_Metallic.png
map_Bump -bm 1.000000 C:/Flame_Normal.png

